@startumlpackage cl.ucn.disc.ads.tragamonedas <<Folder>>{  package model <<Folder>> {    class Rueda <<domain>>    {      -RANDOM: java.util.Random      -MAX_VALUE: int = 10      -valor: int = 0      +Rueda()      +girarAlAzar(): void      +getValor(): int      +getChar(): char    }  }    package services <<Folder>> {      interface Tragamonedas    {      +realizarApuesta(int apuesta): int      +getRuedaValues(): List<Character>      +getSaldo(): int      -girarRuedas(): void      -getPremio(int apuesta): int      -isValorRuedasIgualesDistintoDeCero(): boolean    }        class TragamonedasImpl    {      -NUMERO_RUEDAS: int = 3      -ruedas: List<Rueda>      -saldo: int      +TragamonedasImpl(int saldo)      +realizarApuesta(int apuesta): int      +getRuedaValues(): List<Character>      +getSaldo(): int      -girarRuedas(): void      -getPremio(int apuesta): int      -isValorRuedasIgualesDistintoDeCero(): boolean    }  }    class TheMain  {    -IN: java.util.Scanner    +main(String[] args): void  }    Tragamonedas <|.. TragamonedasImpl : implements  Rueda "3" <-- TragamonedasImpl : contiene  TragamonedasImpl <.. TheMain : usa}@enduml
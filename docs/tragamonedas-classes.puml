@startumlpackage cl.ucn.disc.ads.tragamonedas <<Folder>>{  package model <<Folder>> {    class Box <<domain>> {      -NUMERO_RUEDAS: int = 3      -ruedas: List<Rueda>      +Box()      +realizarApuesta(int ValorApuesta): int      -girarRuedas(): void      -getPremio(int apuesta): int      -isValorRuedasIgualesDistintoDeCero(): boolean      +getRuedaValues(): List<Character>    }        class Rueda <<domain>>    {      -RANDOM: java.util.Random      -MAX_VALUE: int = 10      -valor: int = 0      +Rueda()      +girarAlAzar(): void      +getValor(): int      +getChar(): char    }  }    package services <<Folder>> {      interface Tragamonedas    {      +realizarApuesta(int apuesta): int      +getRuedaValues(): List<Character>      +getSaldo(): int    }        class TragamonedasImpl    {      -box: Box      -saldo: int      +TragamonedasImpl(int saldo)      +realizarApuesta(int apuesta): int      +getRuedaValues(): List<Character>      +getSaldo(): int    }  }    class TheMain  {    -IN: java.util.Scanner    +main(String[] args): void  }    Tragamonedas <|.. TragamonedasImpl : implements  Box "1" <-- TragamonedasImpl : contiene  Rueda "3" <-- Box : contiene  TragamonedasImpl <.. TheMain : usa}@enduml